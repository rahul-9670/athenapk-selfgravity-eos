<comment>
problem = E7r (double flux + mesh refinement) pure contact, star states of R4_ionization, u = mov, N = 400

<job>
problem_id = eos_test

<problem/eos_test>
mode = riemann
x0 = 0.35
rhoL = 5698043741.696797
TL = 17405.04112898509
uL = 125.9711150274905
rhoR = 15372317457.795109
TR = 10075.619459785077
uR = 125.9711150274905
espL_code = 41751.68456274639
espR_code = 14847.599259165014

<parthenon/mesh>
refinement = adaptive
nx1 = 200
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
numlevel = 3


<parthenon/meshblock>
nx1 = 20
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.002381498329474431
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_plain   # 1D decks: dedner_extended (production, 3D) segfaults in 1D (E-F3); B = 0 here
eos_floor_consistent = true
dfloor = 1.0e-12
pfloor = 1.0e-14
eos_interp = p_over_rho

<physics>
self_gravity = false

<parthenon/output0>
file_type = hdf5
variables = prim, cons
dt = 0.00029768729118430387

<refinement>
type = maxdensity
maxdensity_refine_above = 1.0e10
maxdensity_deref_below = 9.0e9
