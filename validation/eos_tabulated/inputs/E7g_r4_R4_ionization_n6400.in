<comment>
problem = E7g R4_ionization on table r4, p_over_rho linear, N = 6400

<job>
problem_id = eos_test

<problem/eos_test>
mode = riemann
x0 = 0.5
rhoL = 18291567587.342236
TL = 30000.0
uL = 0.0
rhoR = 1829156758.7342236
TR = 6000.0
uR = 0.0
espL_code = 50927.54065527361
espR_code = 5959.547958698264

<parthenon/mesh>
refinement = none
nx1 = 6400
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 6400
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.002797495716895197
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/validation/eos_tabulated/runs/E7g_tables/eos_table_v5cold_r4.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_plain   # 1D decks: dedner_extended (production, 3D) segfaults in 1D (E-F3); B = 0 here
eos_floor_consistent = true
dfloor = 1.0e-12
pfloor = 1.0e-14
eos_interp = p_over_rho

<physics>
self_gravity = false

<parthenon/output0>
file_type = hdf5
variables = prim
dt = 0.002797495716895197
