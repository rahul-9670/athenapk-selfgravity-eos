<comment>
E7x: E6 S3 acoustic wave (amp 1e-4) through a static refined patch [0.25,0.5] -- ghost-fill effect on smooth flow
problem = tabulated-EOS acoustic wave, state S3: rho 1e-12 g/cc, T 500 K, cs 8.37577 code, one period

<job>
problem_id = eos_test

<problem/eos_test>
mode = wave
rho0 = 1829156.7587342234
T0 = 500.0
amp = 1.0e-4

<parthenon/mesh>
refinement = static
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
numlevel = 2


<parthenon/meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.11939198481154509
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_plain   # 1D decks: dedner_extended (production, 3D) indexes y/z neighbours and segfaults in 1D; B = 0 here
eos_floor_consistent = true
dfloor = 1.0e-12
pfloor = 1.0e-14

<physics>
self_gravity = false

<parthenon/output0>
file_type = hdf5
variables = prim, cons
dt = 0.11939198481154509

<parthenon/static_refinement0>
x1min = 0.25
x1max = 0.5
level = 1
