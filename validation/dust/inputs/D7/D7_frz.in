<comment>
problem = dust D7_frz: uniform oblique flow (2, 1) c_s through diode faces, clamp True

<job>
problem_id = eos_test

<problem/eos_test>
mode = divb
rho0 = 1829156.7587342234
T0 = 20.0
u0 = 3.6190752974509555
v0y = 1.8095376487254777
bamp = 0.0
rb = 0.1
scalar0 = 0.01
scalar1 = 1.0e-5

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = diode
ox1_bc = diode
nx2 = 64
x2min = 0.0
x2max = 1.0
ix2_bc = diode
ox2_bc = diode
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.5526273524645016
nlim = -1

<hydro>
fluid = glmmhd
riemann = hlld
reconstruction = plm
divergence_control = glm
glmmhd_source = dedner_extended
glmmhd_alpha = 0.1
glmmhd_damping = midpoint
first_order_flux_correct = false
vl2_predictor_recon = same
dfloor = 1.0e-6
pfloor = 1.0e-8
eos_floor_consistent = true
lean_registers = true
ghost_sync_rounds = 1
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold_rho26.bin
gamma = 1.4             # production deck value; unused by the table
eos_interp = p
Tfloor = 0.2726
double_flux = true
eos_table_allow_no_radiation = true   # validation-only escape (no radiation in these tests)
boundary_flux_clamp = true
boundary_flux_clamp_wall = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_energy_shock_eta1 = true
dual_energy_shock_detector = kv
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_shared_select = true
dual_comp_ghost = true
dual_energy_heat_rkl2 = true
dual_energy_heat_exact = true
dual_energy_flux = density
boundary_clamp_dual = true
diode_energy_consistent = true
nscalars = 2

<physics>
self_gravity = false
radiation = false
dust = true

<dust>
evolve = true
scalar_index = 0
a_ref_cm = 1.0e-5
f_dg_ref = 0.01
T_subl_K = 1.5e3
opacity_size_law = bridged
opacity_gas_split = true
rho_grain_cgs = 3
alpha_turb = 0.01
omega_ref_cgs = 1e-13
mu_n = 2.33
growth_cap = 0.1
omega_local = true
subl_irreversible = true
freeze_growth = true   # test value (production: false)
dual_energy = true

<parthenon/output0>
file_type = hdf5
variables = prim, cons
dt = 0.1381568381161254

<parthenon/output1>
file_type = hst
dn = 10
