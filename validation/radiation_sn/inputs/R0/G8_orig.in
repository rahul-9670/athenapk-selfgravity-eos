# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_g8/deck.in
<comment>
problem = GATE G8 -- Sn THICK-EQUILIBRIUM UNIT CALIBRATION.
#
# THE FIRST Sn GATE THAT GRADES AN ANSWER. G0-G7 graded structure: bit-identity when off, a
# bandwidth fraction, a register count, an iteration count, a chat spread. None of them could
# tell a correct radiation field from one wrong by a constant factor -- and for the whole
# prototype phase the field WAS meaningless, because sn.src was seeded from M1's own Er and
# nothing was ever written back to rad.Er.
#
# THE PHYSICS. A static, uniform, optically thick, NON-scattering medium at fixed temperature
# has exactly one equilibrium: every ordinate relaxes to the source function, isotropically,
# and the radiation energy density is the Planck value
#
#     Er  ->  B = a_R T^4          (gray; n_group = 1 so PlanckFraction == 1)
#     Fr  ->  0                    (isotropic field carries no net flux)
#
# WHY THE CONSTANTS ARE HAND-SET. arad_code = 1 and p0 = rho0 = 1 with gamma = 5/3 give
# T = p/rho = 1 exactly, so the target is Er = 1.0 * 1.0^4 = 1 EXACTLY -- no unit derivation
# stands between the deck and the expected number, and the gate cannot be passed by an
# analysis script that reproduces the same unit bug as the code. c_code and creduc are set
# for the same reason: chat = 100 exactly.
#
# RELAXATION RATE. Backward Euler leaves a fraction 1/(1 + chi*chat*dt) of the initial offset
# per step, with chi = rho*kappa_a = 100, chat = 100 and dt ~ 0.3*dx/c_s ~ 0.0145 => ~1/146
# per step, so the ~34 steps to tlim overshoot machine precision by decades. The gate
# therefore measures the CONSTANT, not the rate. Initial Er = 1e-30 (not 0) so the approach
# spans a full 30 decades and no coincidence of scale can fake it.
#
# ARMS (see submit_g8.sh): planck = the physical source, must reach 1.0; m1er = the retired
# placeholder, must NOT (it is its own fixed point and stays at 1e-30). The second arm exists
# because a gate that only its intended configuration can fail is not evidence -- this one
# shows the test discriminates between the two sources rather than passing on both.

<job>
# problem_id SELECTS THE PROBLEM GENERATOR, it is not just an output prefix. This build is the
# research one and registers `collapse_be` plus the three radiation benchmarks; anything else
# aborts at main.cpp:92. Dumps are therefore named rad_pulse.out0.*, and the two arms are kept
# apart by running in separate directories rather than by file name.
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-30
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
# 3D and multi-block on purpose: all three transport directions live, and the red-black sweep
# runs ACROSS block boundaries so the halo exchange is part of what is graded.
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
# Task-collection watchdog: the default 300 s trips on a CPU rehearsal of an iterative
# sublist long before anything is wrong. Measured on the sn_g234 CPU smoke run.
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
# tlim REACHED, not nlim: a run that stops on nlim relies on the driver emitting a final
# dump, and this gate must not depend on that. dt is constant here (static uniform gas,
# 0.3*dx/c_s ~ 0.0145), so tlim = 0.5 is ~34 steps and the last scheduled dump is guaranteed.
tlim       = 0.5
nlim       = 200
ncycle_out = 1

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn
closure = M1
sn_nzeta = 4
sn_npsi = 8
sn_source = planck
sn_writeback = true
sn_rel_tol = 1.0e-10
sn_max_iterations = 300
n_group = 1
# Hand-set so the expected answer is exactly 1.0. See the header.
c_code = 100.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 100.0
kappa_s_code = 0.0
# Wide open so the emission temperature is never edge-clamped -- a clamp here would move the
# target without saying so, which is the exact failure mode the tabulated tables produce at
# depth (see the clamp note in CLAUDE.md).
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = true
cfl = 0.3

<parthenon/output0>
file_type = hdf5
# dt, NOT dn: a negative dn does not disable the trigger, it writes EVERY cycle.
dt = 0.1
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
