# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_g9/deck.in
<comment>
problem = GATE G9 -- Sn MATTER COUPLING: exact conservation + the coupled equilibrium.
#
# G8 showed the radiation field reaches the right value against a FIXED gas. This gate lets the
# two exchange energy and asks two questions the previous gates could not:
#
#   1. CONSERVATION. The code's conserved quantity under RSLA is  e_gas + (c/chat)*Er  (that is
#      the convention MatterCoupling uses, `Er0 - chat/c*(dEg+dEk)`, and it is what falls out
#      of the gas losing the TRUE rate while Er evolves at the reduced one). In a uniform
#      periodic box with zero velocity, hydro moves nothing, so ANY change in that total is the
#      coupling operator failing to conserve. Expected at the solver tolerance, not at
#      "small": the coupling is computed from the SAME eta and chi_a the sweep emitted with,
#      which makes the discrete moment equation an identity rather than an approximation.
#
#   2. THE COUPLED EQUILIBRIUM. Gas starts hot with an empty radiation field and they relax to
#      Er = a_R T^4 at whatever T the conserved total allows. With rho = 1, gamma = 5/3,
#      a_R = 1 the final state solves  1.5 T + (c/chat) T^4 = 1.5.  The checker solves that
#      itself from constants it reads out of the DUMP (radiation/arad, /c, /chat,
#      Hydro/AdiabaticIndex), so it cannot pass by reproducing a deck value the code also got
#      wrong.
#
# ARMS. creduc = 1 and creduc = 4, and the second is the point: at creduc = 1 the (c/chat)
# factor is exactly 1 and INVISIBLE, so that arm cannot tell a correct RSLA weighting from a
# missing one. At creduc = 4 the conserved total is e_gas + 4*Er and the answer moves from
# T = 0.7681 to T = 0.6165 -- a 20% shift the gate would be blind to otherwise. Same lesson as
# G8's arm_t2: constants equal to 1 hide the factor they multiply.
#
# STABILITY. The exchange is EXPLICIT in the gas temperature (B is lagged at T^n), so this deck
# is deliberately weakly coupled: c = 10, kappa_a = 0.5 gives |dE_gas|/e_int ~ 0.05 per step
# against the code's own 0.1 warning threshold, and ~0.07 relaxation per step so t = 3 is
# ~14 e-foldings. A strongly coupled version of this test WOULD oscillate, and that is a
# property of the operator, not of the deck -- the implicit coupling is the next increment.

<job>
# problem_id SELECTS THE PROBLEM GENERATOR, it is not just an output prefix. This build is the
# research one and registers `collapse_be` plus the three radiation benchmarks; anything else
# aborts at main.cpp:92. Dumps are therefore named rad_pulse.out0.*, and the two arms are kept
# apart by running in separate directories rather than by file name.
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-30
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
# 3D and multi-block on purpose: all three transport directions live, and the red-black sweep
# runs ACROSS block boundaries so the halo exchange is part of what is graded.
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
# Task-collection watchdog: the default 300 s trips on a CPU rehearsal of an iterative
# sublist long before anything is wrong. Measured on the sn_g234 CPU smoke run.
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
# tlim REACHED, not nlim: a run that stops on nlim relies on the driver emitting a final
# dump, and this gate must not depend on that. dt is constant here (static uniform gas,
# 0.3*dx/c_s), so tlim = 3.0 is ~200 steps and the last scheduled dump is guaranteed.
tlim       = 3.0
nlim       = 5000
ncycle_out = 50

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn
closure = M1
sn_nzeta = 4
sn_npsi = 8
sn_source = planck
sn_writeback = true
sn_matter_coupling = true
sn_rel_tol = 1.0e-10
sn_max_iterations = 300
n_group = 1
# Hand-set so the expected answer is exactly 1.0. See the header.
c_code = 10.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 0.5
kappa_s_code = 0.0
# Wide open so the emission temperature is never edge-clamped -- a clamp here would move the
# target without saying so, which is the exact failure mode the tabulated tables produce at
# depth (see the clamp note in CLAUDE.md).
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = true
cfl = 0.3

<parthenon/output0>
file_type = hdf5
# dt, NOT dn: a negative dn does not disable the trigger, it writes EVERY cycle.
dt = 0.5
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
