# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_g10/deck.in
<comment>
problem = GATE G10 -- SCATTERING must not exchange energy with the gas.
#
# THE CLAIM UNDER TEST. Scattering removes a photon from an ordinate and returns it to the
# field; it does NOT give its energy to the matter. So the coupled equilibrium temperature must
# be INDEPENDENT of kappa_s, and total energy must conserve just as well with scattering on.
# The tempting implementation -- charge the gas with the total extinction chi, which is what the
# cached rad.chi_g gives you and what the prototype sweep used -- gets both wrong, over-cooling
# the radiation by (chi_s/chi_a) and landing the gas at a different temperature entirely.
# tests/test_sn_units.cpp check 5 measures that error factor as exactly 1 + chi_s/chi_a on the
# algebra; this gate measures it on the code.
#
# ARMS: kappa_s = 0 and kappa_s = 2 (four times the absorption). Same gas, same a_R, same
# everything else. BOTH must land on the SAME equilibrium T and conserve to the solver
# tolerance. If the energy accounting used total chi, the kappa_s = 2 arm would land elsewhere
# and the two arms would disagree -- which is precisely the discrimination the second arm buys.
#
# The scattering also makes the source iteration genuinely coupled for the first time: the
# sweep now carries chi_s*J in its source, which sits OUTSIDE the per-ordinate diagonal. That
# is why the convergence test is a TRUE RESIDUAL here and not an iterate increment -- an
# increment test cannot tell slow source iteration from convergence.

<job>
# problem_id SELECTS THE PROBLEM GENERATOR, it is not just an output prefix. This build is the
# research one and registers `collapse_be` plus the three radiation benchmarks; anything else
# aborts at main.cpp:92. Dumps are therefore named rad_pulse.out0.*, and the two arms are kept
# apart by running in separate directories rather than by file name.
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-30
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
# 3D and multi-block on purpose: all three transport directions live, and the red-black sweep
# runs ACROSS block boundaries so the halo exchange is part of what is graded.
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
# Task-collection watchdog: the default 300 s trips on a CPU rehearsal of an iterative
# sublist long before anything is wrong. Measured on the sn_g234 CPU smoke run.
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
# tlim REACHED, not nlim: a run that stops on nlim relies on the driver emitting a final
# dump, and this gate must not depend on that. dt is constant here (static uniform gas,
# 0.3*dx/c_s), so tlim = 3.0 is ~200 steps and the last scheduled dump is guaranteed.
tlim       = 3.0
nlim       = 5000
ncycle_out = 50

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12
dual_energy = true   # R0 prod overlay
dual_energy_eta1 = 5e-2   # R0 prod overlay
dual_energy_sync_step_end = true   # R0 prod overlay
dual_energy_unsigned_prim = true   # R0 prod overlay
dual_energy_exact_resync = true   # R0 prod overlay
dual_energy_eta2 = 0.1   # R0 prod overlay
dual_energy_kappa = 3.0   # R0 prod overlay
dual_energy_shock_comp = 0.02   # R0 prod overlay
dual_energy_shared_select = true   # R0 prod overlay
dual_comp_ghost = true   # R0 prod overlay
dual_energy_heat_rkl2 = true   # R0 prod overlay
boundary_clamp_dual = true   # R0 prod overlay
ghost_sync_rounds = 1   # R0 prod overlay

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn   # R0 prod overlay
closure = M1
sn_nzeta = 4   # R0 prod overlay
sn_npsi = 8   # R0 prod overlay
sn_source = planck
sn_writeback = true
sn_matter_coupling = true
sn_rel_tol = 1.0e-10
sn_max_iterations = 4000   # R0 prod overlay
n_group = 1
# Hand-set so the expected answer is exactly 1.0. See the header.
c_code = 10.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 0.5
kappa_s_code = 0.0   # overridden per arm
# Wide open so the emission temperature is never edge-clamped -- a clamp here would move the
# target without saying so, which is the exact failure mode the tabulated tables produce at
# depth (see the clamp note in CLAUDE.md).
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = true
cfl = 0.3
sn_solver = bicgstab   # R0 prod overlay
sn_smoother = ordered   # R0 prod overlay
sn_precond_sweeps = 1   # R0 prod overlay
sn_spatial = sou   # R0 prod overlay
sn_sou_kappa = 1.0   # R0 prod overlay
sn_sou_linear_prolong = true   # R0 prod overlay
sn_red_black = true   # R0 prod overlay
sn_diamond_fixup = true   # R0 prod overlay
sn_criterion = residual   # R0 prod overlay
sn_rosseland_excess = true   # R0 prod overlay
sn_fleck_alpha = 1.0   # R0 prod overlay
sn_bc_incoming = planck   # R0 prod overlay
sn_bc_tbg_K = 10.0   # R0 prod overlay
sn_radiation_force = false   # R0 prod overlay
sn_restart_reproject = false   # R0 prod overlay
sn_dual_energy = true   # R0 prod overlay
sn_fallback = true   # R0 prod overlay
sn_krylov_dot_scale = true   # R0 prod overlay
sn_skip_extinction = true   # R0 prod overlay
sn_skip_group_rel = 1e-12   # R0 prod overlay

<parthenon/output0>
file_type = hdf5
# dt, NOT dn: a negative dn does not disable the trigger, it writes EVERY cycle.
dt = 0.5
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
