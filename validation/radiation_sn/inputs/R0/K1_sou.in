# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_k1_sou/deck.in
<comment>
problem = GATE K1 -- BiCGSTAB solves the SAME system the validated Richardson path solves.
#
# WHAT THIS GRADES. Three arms, identical deck, one CLI key apart:
#   ref   : sn_solver = richardson, ordered sweep   -- the already-validated answer
#   kry0  : sn_solver = bicgstab, sn_precond_sweeps = 0  -- IDENTITY preconditioner
#   kry1  : sn_solver = bicgstab, sn_precond_sweeps = 1  -- ordered sweep as preconditioner
# PASS requires rad.Er to agree across all three to solver tolerance. kry0 isolates the
# BiCGSTAB driver (recurrences, reductions, breakdown guards) from the preconditioner; kry1
# then adds the smoother. If kry0 fails and kry1 passes, the driver is wrong and the smoother
# is hiding it.
#
# THE SOURCE IS SPATIALLY VARYING, ON PURPOSE. A uniform gas gives a uniform intensity, and a
# uniform state is a fixed point of almost any operator -- it cannot tell a correct solve from
# a broken one (the same blindness that let a G8 arm pass at rel 0.0 because its constant was
# 1). thermal_tophat puts a mesh-exact temperature step in the box so the Planck source, and
# hence the solution, has real structure, and it is MESH-EXACT so every arm samples the
# identical source.
#
# c_code = 10, creduc = 1 => chat = 10; dx = 1/32; dt ~ 0.3*dx/c_s. The transport Courant
# number here is C = chat*dt/dx ~ 3, i.e. a regime the ordered sweep already handles well.
# That is deliberate for a CORRECTNESS gate: the reference arm must actually converge so there
# is something to compare against. The hard regime (C = 15,231) is gate K2.

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0 = 1.0
p0   = 1.0
E0   = 1.0e-30
Eamp = 0.0
reduced_flux = 0.0
thermal_wave = true
# COSINE WITH ALL THREE MODES LIVE, not the top-hat, and this is a CORRECTION.
# The top-hat varies in pos[0] ONLY (rad_pulse.cpp:145). A field uniform in y and z makes the
# y- and z-direction upwind terms act on a constant, where sum adx*u_up - sum adx*u cancels
# identically -- so an error in either stencil is INVISIBLE and the gate silently graded one
# transport direction out of three. (It also explains why the operator gate reported reldiff
# exactly 0 rather than a few ulp.) The top-hat exists for mesh-exactness across AMR arms;
# this gate is refinement = none, every arm shares one mesh, so that reason does not apply
# and the cosine's 3-D structure is strictly better here.
thermal_tophat = false
wave_n1 = 1
wave_n2 = 1
wave_n3 = 1
thermal_amplitude = 0.5
# NONZERO initial radiation field. With 0.0 the ordinates start at zero, and A*x = 0 for ANY
# stencil -- the operator gate is then blind by construction. Measured: a deliberately broken
# SnApplyA passed the gate at x = 0 (job 2738625).
thermal_radiation_factor = 1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 32
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 32
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 0.05
nlim       = 6
ncycle_out = 1

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn
closure = M1
sn_nzeta = 4
sn_npsi = 8
sn_source = planck
sn_writeback = true
sn_matter_coupling = false
# THE KEY IS sn_smoother, NOT sn_ordered_sweep. The first version of this deck wrote
# `sn_ordered_sweep = true`, which does not exist: parthenon printed "The following input
# parameters are set but unused: radiation/sn_ordered_sweep" and every reference arm silently
# ran the DEFAULT redblack smoother. The K2 speed comparison was therefore made against the
# weaker smoother and overstated the Krylov win. Read the unused-parameter warning.
sn_smoother = ordered
sn_rel_tol = 1.0e-10
sn_max_iterations = 4000
sn_verify_operator = true   # R0 sou family
n_group = 1
c_code = 10.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 1.0
kappa_s_code = 0.0
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = false
cfl = 0.3
sn_spatial = sou   # R0 sou family
sn_sou_kappa = 1.0   # R0 sou family
sn_sou_linear_prolong = true   # R0 sou family

<parthenon/output0>
file_type = hdf5
dt = 0.05
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3
