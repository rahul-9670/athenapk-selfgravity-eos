# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_g11/deck.in
<comment>
problem = GATE G11 -- the FLECK linearisation buys UNCONDITIONAL STABILITY. Measured, not argued.
#
# G9 passed with an EXPLICIT matter coupling, on a deliberately weakly coupled deck
# (|dE_gas|/e_int ~ 0.05 per step) -- and said so, because an explicit exchange is only
# conditionally stable and a strongly coupled version of that same test would oscillate. This
# gate IS that strongly coupled version.
#
# THE STIFFNESS. kappa_a = 20 with c = 10 and dt ~ 0.0165 gives
#   c*dt*chi_a*dB/de = 10 * 0.0165 * 20 * (4 a_R T^3 (gamma-1)/rho) = 10*0.0165*20*2.667 ~ 8.8,
# so an explicit exchange overshoots the equilibrium by ~9x per step -- far outside the
# stability limit of ~2 -- while the Fleck factor f = 1/(1 + 8.8) ~ 0.10 keeps it bounded.
#
# ARMS, same deck, one CLI key apart:
#   alpha1 : sn_fleck_alpha = 1  -- backward Euler. MUST reach the equilibrium, conserve, and
#            never trip the operator's own |dE|/e_int > 0.1 warning or floor a cell.
#   alpha0 : sn_fleck_alpha = 0  -- recovers the explicit coupling EXACTLY. MUST misbehave.
#
# A gate that only its intended configuration can pass is not evidence, so the alpha0 arm is
# required to FAIL: if the explicit scheme were also fine here, the Fleck machinery would be
# buying nothing and should be deleted rather than defended.
#
# THE COST, stated up front. The Fleck factor returns (1-f)*chi_a to the field as effective
# scattering, so source iteration contracts by 1 - f*chi_a/chi ~ 1 - f per sweep: at f = 0.1
# that is ~0.9, needing ~175 sweeps for 1e-8 against the ~18 an uncoupled solve takes. Hence
# sn_max_iterations = 2000 here. Stability is bought with iterations, and this deck is where
# the exchange rate is visible.

<job>
# problem_id SELECTS THE PROBLEM GENERATOR, it is not just an output prefix. This build is the
# research one and registers `collapse_be` plus the three radiation benchmarks; anything else
# aborts at main.cpp:92. Dumps are therefore named rad_pulse.out0.*, and the two arms are kept
# apart by running in separate directories rather than by file name.
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-30
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
# 3D and multi-block on purpose: all three transport directions live, and the red-black sweep
# runs ACROSS block boundaries so the halo exchange is part of what is graded.
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
# Task-collection watchdog: the default 300 s trips on a CPU rehearsal of an iterative
# sublist long before anything is wrong. Measured on the sn_g234 CPU smoke run.
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
# tlim REACHED, not nlim: a run that stops on nlim relies on the driver emitting a final
# dump, and this gate must not depend on that. dt is constant here (static uniform gas,
# 0.3*dx/c_s), so tlim = 3.0 is ~200 steps and the last scheduled dump is guaranteed.
tlim       = 1.0
nlim       = 5000
ncycle_out = 50

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn
closure = M1
sn_nzeta = 4
sn_npsi = 8
sn_source = planck
sn_writeback = true
sn_matter_coupling = true
sn_rel_tol = 1.0e-8
sn_max_iterations = 2000
n_group = 1
# Hand-set so the expected answer is exactly 1.0. See the header.
c_code = 10.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 20.0
kappa_s_code = 0.0
# Wide open so the emission temperature is never edge-clamped -- a clamp here would move the
# target without saying so, which is the exact failure mode the tabulated tables produce at
# depth (see the clamp note in CLAUDE.md).
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = true
cfl = 0.3

<parthenon/output0>
file_type = hdf5
# dt, NOT dn: a negative dn does not disable the trigger, it writes EVERY cycle.
# Frequent dumps: the explicit arm's failure mode is an OVERSHOOT past equilibrium, and with
# only 3 dumps the trajectory cannot show it. 20 dumps over tlim = 1.0 resolves the approach.
dt = 0.05
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
