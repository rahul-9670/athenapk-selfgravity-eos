# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_seam2/deck.in
<comment>
problem = THE DEFINITIVE TEST, v2 -- with the SOURCE CONFOUND REMOVED.
#
# v1 (runs/sn_g6g/, job 2734018) reported the AMR steady state as 2.50x worse than not refining.
# THAT NUMBER WAS CONTAMINATED, and the contamination was found by checking a premise rather
# than by any failure:
#
#   volume-weighted <a_R T^4>, i.e. THE SOURCE ITSELF:
#       uniform coarse vs uniform fine :  3.5e-16   (identical)
#       AMR            vs uniform fine :  1.45e-03  (DIFFERENT)
#
# A cell-centred midpoint sample of a periodic cosine is spectrally accurate, so both uniform
# meshes integrate T^4 exactly. A MIXED mesh is not a uniform sampling and loses that property.
# The AMR arm was solving a different source problem, and roughly a third of the 3.08e-03
# "seam error" was the initial condition rather than transport.
#
# THE FIX: a TOP-HAT whose edges lie on COARSE cell faces. dx_coarse = 1/16 = 0.0625, and the
# half-width 0.125 = 2*dx_coarse, so no cell on ANY mesh in the hierarchy straddles the jump and
# <T^4> is identical to machine precision in all three arms. The checker now ASSERTS that
# equality and refuses to grade if it fails -- the confound cannot come back silently.
#
# The temperature jump is at x = +-0.125; the refinement seam is at x = +-0.25. They are kept
# apart on purpose, so a seam effect cannot be confused with a discontinuity effect. The
# radiation still has a strong gradient at the seam, because it diffuses outward from the hot
# slab across it.
#
# Everything else is unchanged from v1: isobaric (uniform pressure, wave in density) so the gas
# is frozen and the driver never decays; matter coupling OFF; tau_cell = 0.1, the production
# median; graded on ACCURACY against a uniform run at the AMR's finest resolution.

<job>
# problem_id SELECTS THE PROBLEM GENERATOR, it is not just an output prefix. This build is the
# research one and registers `collapse_be` plus the three radiation benchmarks; anything else
# aborts at main.cpp:92. Dumps are therefore named rad_pulse.out0.*, and the two arms are kept
# apart by running in separate directories rather than by file name.
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-6
thermal_wave = true
thermal_isobaric = true
thermal_amplitude = 0.3
thermal_tophat = true
thermal_tophat_halfwidth = 0.125
wave_n1 = 1
wave_n2 = 0
wave_n3 = 0
thermal_radiation_factor = 1.0
Eamp  = 1.0
x0    = 0.0
width = 0.12
reduced_flux = 0.0

<parthenon/mesh>
refinement = static
nghost = 2
# 3D and multi-block on purpose: all three transport directions live, and the red-black sweep
# runs ACROSS block boundaries so the halo exchange is part of what is graded.
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
# Task-collection watchdog: the default 300 s trips on a CPU rehearsal of an iterative
# sublist long before anything is wrong. Measured on the sn_g234 CPU smoke run.
task_collection_timeout_in_seconds = 3600

<parthenon/meshblock>
# 4^3, giving 4x4x4 = 64 blocks of extent 0.25. THE FIRST VERSION USED 8^3, which makes only
# 2x2x2 = 8 blocks of extent 0.5 -- so a region centred on the origin overlaps EVERY block and
# the whole mesh refines to level 1. The gate's liveness check caught exactly that: it reported
# "levels present [1]" and the AMR arm's totals matched the uniform-fine arm to every digit.
# A uniformly refined mesh has no coarse-fine interface, so the run would have measured nothing
# while looking like a clean result.
nx1 = 4
nx2 = 4
nx3 = 4

# The central octant, one level finer. Interior on every side, so the coarse-fine boundary is
# a genuine internal interface and not an artefact of the periodic wrap.
<parthenon/static_refinement0>
# A SLAB, not an octant: refined across the full domain in y and z, so the ONLY coarse-fine
# interfaces are the two planes normal to x-hat. The tangential arm overrides these bounds to
# rotate the slab into y; nothing else differs between the arms.
x1min = -0.125
x1max =  0.125
x2min = -0.5
x2max =  0.5
x3min = -0.5
x3max =  0.5
level = 1

<parthenon/time>
integrator = vl2
cfl        = 0.3
# tlim REACHED, not nlim: a run that stops on nlim relies on the driver emitting a final
# dump, and this gate must not depend on that. dt is constant here (static uniform gas,
# 0.3*dx/c_s), so tlim = 3.0 is ~200 steps and the last scheduled dump is guaranteed.
tlim       = 2.0
nlim       = 5000
ncycle_out = 50

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12
dual_energy = true   # R0 prod overlay
dual_energy_eta1 = 5e-2   # R0 prod overlay
dual_energy_sync_step_end = true   # R0 prod overlay
dual_energy_unsigned_prim = true   # R0 prod overlay
dual_energy_exact_resync = true   # R0 prod overlay
dual_energy_eta2 = 0.1   # R0 prod overlay
dual_energy_kappa = 3.0   # R0 prod overlay
dual_energy_shock_comp = 0.02   # R0 prod overlay
dual_energy_shared_select = true   # R0 prod overlay
dual_comp_ghost = true   # R0 prod overlay
dual_energy_heat_rkl2 = true   # R0 prod overlay
boundary_clamp_dual = true   # R0 prod overlay
ghost_sync_rounds = 1   # R0 prod overlay

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn   # R0 prod overlay
closure = M1
sn_nzeta = 4   # R0 prod overlay
sn_npsi = 8   # R0 prod overlay
sn_source = planck
sn_writeback = true
sn_matter_coupling = false
sn_rel_tol = 1.0e-10
sn_max_iterations = 4000   # R0 prod overlay
n_group = 1
# Hand-set so the expected answer is exactly 1.0. See the header.
c_code = 10.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 1.6   # overridden per arm
kappa_s_code = 0.0
# Wide open so the emission temperature is never edge-clamped -- a clamp here would move the
# target without saying so, which is the exact failure mode the tabulated tables produce at
# depth (see the clamp note in CLAUDE.md).
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = true
cfl = 0.3
sn_solver = bicgstab   # R0 prod overlay
sn_smoother = ordered   # R0 prod overlay
sn_precond_sweeps = 1   # R0 prod overlay
sn_spatial = sou   # R0 prod overlay
sn_sou_kappa = 1.0   # R0 prod overlay
sn_sou_linear_prolong = true   # R0 prod overlay
sn_red_black = true   # R0 prod overlay
sn_diamond_fixup = true   # R0 prod overlay
sn_criterion = residual   # R0 prod overlay
sn_rosseland_excess = true   # R0 prod overlay
sn_fleck_alpha = 1.0   # R0 prod overlay
sn_bc_incoming = planck   # R0 prod overlay
sn_bc_tbg_K = 10.0   # R0 prod overlay
sn_radiation_force = false   # R0 prod overlay
sn_restart_reproject = false   # R0 prod overlay
sn_dual_energy = true   # R0 prod overlay
sn_fallback = true   # R0 prod overlay
sn_krylov_dot_scale = true   # R0 prod overlay
sn_skip_extinction = true   # R0 prod overlay
sn_skip_group_rel = 1e-12   # R0 prod overlay

<parthenon/output0>
file_type = hdf5
# dt, NOT dn: a negative dn does not disable the trigger, it writes EVERY cycle.
dt = 0.5
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
