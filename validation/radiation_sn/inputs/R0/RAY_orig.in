# R0 deck generated by scripts/make_decks_R0.py from the earlier Sn gate deck sn_ray4/deck.in
<comment>
problem = ITEM #4 (RAD_ACCURACY_ITEMS_2026-09-14.md) -- RAY EFFECTS, controlled measurement.
# A COMPACT hot cube (4x4x4 cells, half-width 1/24 = 2 dx) in a cold PURELY ABSORBING medium
# (kappa_s = 0, matter coupling OFF so the source is frozen), the classic ray-effect
# configuration: nothing scatters, so the field at a point is the sum over the discrete
# ordinates that happen to intersect the source. Isobaric top-hat (rho = rho0*T0/T, uniform
# p) so the gas cannot move (verified in sn_g6h/g6i: max|v| = 0 exactly).
#   T_in = 1.9, T_out = 0.1  ->  emissivity ratio (T_in/T_out)^3 = 6859 per unit volume;
#   kappa_a = 0.8: chi_out = 0.8*rho_out = 8 (tau_box = 8, tau_cell = 0.167),
#                  chi_in = 0.8/1.9 = 0.42 (cube optical depth 0.035: emits volumetrically).
#   Periodic images sit >= 0.65 from any shell point (r <= 0.35): weight < 0.3 %.
# STEADY STATE: c_code = 1e3 so chat*dt = 3.5 box lengths per hydro step (dt = 0.3 dx/c_s =
# 3.5e-3): the I^n memory term rdt = 1/(chat dt) = 0.29 decays by 1/(1 + chi*chat*dt) ~ 1/29
# per step, so ~10 steps reach the steady transport solution (at steady state the rdt terms
# cancel exactly and the discrete equation IS the steady transport equation). The first
# version FORCED dt = 1e3 instead and the HYDRO went NaN (measured: max|v| = nan), so the
# frozen-gas premise is asserted by the checker rather than assumed.
# The ordinate set (sn_nzeta, sn_npsi) is the ONLY thing varied between arms.

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-30
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0
thermal_wave = true
thermal_isobaric = true
thermal_tophat = true
thermal_tophat_ndim = 3
thermal_tophat_halfwidth = 0.041666666666666667
thermal_amplitude = 0.9
thermal_radiation_factor = 0.0
wave_n1 = 1
wave_n2 = 0
wave_n3 = 0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 48
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 48
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 48
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic
task_collection_timeout_in_seconds = 7200

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 0.06
nlim       = 100
ncycle_out = 1

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.6666667
riemann        = hlld
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
transport = sn
closure = M1
sn_nzeta = 4
sn_npsi = 8
sn_source = planck
sn_writeback = true
sn_matter_coupling = false
sn_smoother = ordered
sn_rel_tol = 1.0e-10
sn_max_iterations = 4000
n_group = 1
c_code = 1000.0
arad_code = 1.0
creduc = 1.0
opacity_model = constant
kappa_a_code = 0.8
kappa_s_code = 0.0
coupling_tmax_K = 1.0e8
tfloor_code = 1.0e-12
efloor = 1.0e-40
matter_coupling = false
cfl = 0.3

<parthenon/output0>
file_type = hdf5
dt = 0.01
variables = prim, rad.Er, rad.Fr1, rad.Fr2, rad.Fr3

<parthenon/output1>
file_type = hst
dt = 1.0e29
