# R4: dual_energy D7_ref.in (md5 504a6ad3) with rad.Er added to output0 (the only change)
<comment>
problem = D7 radiative relaxation of a uniform box, |v| = 0.0 cs0, beta None, gray Sn kappa_a 1e-05

<job>
problem_id = eos_test

<problem/eos_test>
mode = divb
rho0 = 1.0
T0 = 10.0
u0 = 0.0
v0y = 0.0
v0z = 0.0
B0z = 0.0
bamp = 0.0
rb = 0.1

<parthenon/mesh>
refinement = none
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.0
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold_rho26.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended   # production
dfloor = 1.0e-6
pfloor = 1.0e-8
Tfloor = 0.2726   # code T units (10.0 K) -> 2.73 K, production 2026-10-06
boundary_flux_clamp = false   # production = true, but it zeroes inflow on EVERY mesh-edge face without checking the BC type: a periodic box loses its through-flow (DE-F2)
cons_diag = true
eos_floor_consistent = true
eos_table_allow_no_radiation = true   # validation-only escape (no radiation in these tests)
eos_interp = p
vl2_predictor_recon = dc
double_flux = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_energy_shared_select = true
dual_comp_ghost = true
dual_energy_heat_rkl2 = true
boundary_clamp_dual = true
ghost_sync_rounds = 1


<physics>
self_gravity = false
radiation = true

<parthenon/output0>
file_type = hdf5
variables = prim, cons, dual_switched, rad.Er
dt = 0.1

<parthenon/output1>
file_type = hst
dt = 0.005

<radiation>
transport = sn
closure = M1
creduc = 1.0
n_group = 1
opacity_model = constant
kappa_a_code = 1e-05
kappa_s_code = 0.0
matter_coupling = true
sn_matter_coupling = true
sn_solver = bicgstab
sn_smoother = ordered
sn_precond_sweeps = 1
sn_spatial = sou
sn_sou_kappa = 1.0
sn_rel_tol = 1.0e-8
sn_max_iterations = 4000
sn_nzeta = 4
sn_npsi = 8
sn_krylov_dot_scale = true
sn_skip_extinction = true
sn_skip_group_rel = 1e-12
sn_fallback = true
sn_dual_energy = true
efloor = 1.0e-15
tfloor_code = 5.0e-2
