<comment>
problem = PRODUCTION collapse_be initial condition, single Poisson solve (SG-S7, project-specific).
          Same pgen, box ([-8,8]^3), BE parameters (mass 6, T 10 K, f 5) and gravity keys as the
          production runs; turbulence, rotation and B switched off (they do not enter the Poisson RHS
          beyond rho, and turbulence/rotation only perturb velocities). Exact potential =
          homogeneous cube at rho_amb (Nagy et al. 2000) + spherical excess (f*BE(r) - rho_amb)
          for r < 6.45 (1D quadrature) -- scripts/exact_potentials.py.

<job>
problem_id = collapse_be

<problem/collapse_be>
mass        = 6.0
temperature = 10.0
f           = 5.0
rhocrit     = 1.0e-13
amp         = 0.0
omegatff    = 0.0
turb_mach   = 0.0

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = none
multigrid  = true
nx1    = 64
x1min  = -8.0
x1max  =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = -8.0
x2max  =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = -8.0
x3max  =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 1.0e-6
tlim       = 1.0e30
nlim       = 1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.4
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm

<parthenon/output0>
file_type = hdf5
dt        = 1.0e30
variables = prim, grav.phi

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
