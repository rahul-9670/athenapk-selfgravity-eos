<comment>
problem = Advected self-gravitating slab (SG-D4); artemis inputs/self-gravity/grav_slab.in and
          tst/scripts/self_gravity/grav_slab.py; Hanawa and Mullen 2025 Sec. 4.3. Box (6pi,3pi,3pi),
          Nx = 2 Ny = 2 Nz as in artemis; one period t = 3 pi.

<job>
problem_id = grav_slab

<problem/grav_slab>
nperiod = 1

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = none
multigrid  = true
nx1    = 32
x1min  = 0.0
x1max  = 18.84955592153876
ix1_bc = periodic
ox1_bc = periodic
nx2    = 16
x2min  = 0.0
x2max  = 9.42477796076938
ix2_bc = periodic
ox2_bc = periodic
nx3    = 16
x3min  = 0.0
x3max  = 9.42477796076938
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = rk2
cfl        = 0.9
tlim       = 9.42477796076938
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.66666666667
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm

<parthenon/output0>
file_type = hdf5
dt        = 1.0e30
variables = prim

<parthenon/output1>
file_type = hst
dt        = 0.1

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = true
packed_bc          = true
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
