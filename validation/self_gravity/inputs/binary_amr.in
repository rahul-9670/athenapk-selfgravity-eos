<comment>
problem = SG-S4 unequal-mass binary of uniform spheres on a nested static AMR mesh
          (Tomida and Stone 2023, ApJS 266, 7, Sec. 4.2; Athena++ pgen binary_gravity.cpp):
          M1 = 2 at (6/1024,0,0), M2 = 1 at (-12/1024,0,0), R = 6/1024, box [-0.5,0.5]^3,
          levels l = 1..4 on [-0.5/2^l, 0.5/2^l]^3. Surface cells sub-sampled 10^3 as in T and S.

<job>
problem_id = grav_analytic

<problem/grav_analytic>
profile  = spheres
m1       = 2.0
r1       = 0.005859375
x1       = 0.005859375
m2       = 1.0
r2       = 0.005859375
x2       = -0.01171875
rho_out  = 1.0e-10
pressure = 1.0
nsub     = 10

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = static
numlevel   = 5
multigrid  = true
nx1    = 64
x1min  = -0.5
x1max  =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = -0.5
x2max  =  0.5
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = -0.5
x3max  =  0.5
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 1.0e-6
tlim       = 1.0e30
nlim       = 1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.6666666666666667
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm
dfloor         = 1.0e-30
pfloor         = 1.0e-30

<parthenon/output0>
file_type = hdf5
dt        = 1.0e30
variables = prim, grav.phi
<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true

<parthenon/static_refinement1>
level = 1
x1min = -0.25
x1max =  0.25
x2min = -0.25
x2max =  0.25
x3min = -0.25
x3max =  0.25

<parthenon/static_refinement2>
level = 2
x1min = -0.125
x1max =  0.125
x2min = -0.125
x2max =  0.125
x3min = -0.125
x3max =  0.125

<parthenon/static_refinement3>
level = 3
x1min = -0.0625
x1max =  0.0625
x2min = -0.0625
x2max =  0.0625
x3min = -0.0625
x3max =  0.0625

<parthenon/static_refinement4>
level = 4
x1min = -0.03125
x1max =  0.03125
x2min = -0.03125
x2max =  0.03125
x3min = -0.03125
x3max =  0.03125
