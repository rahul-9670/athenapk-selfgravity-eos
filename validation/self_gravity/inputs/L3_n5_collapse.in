<comment>
problem = n = 5 polytrope collapse (Hanawa and Mullen 2025 Sec. 4.6): pressure made uniform inside 0.9 R,
          gamma = 1.3, h = 0.08 R (box [-5.12, 5.12]^3 at 128^3); bounce and accretion shock; vs 1D reference.

<job>
problem_id = profile1d

<problem/profile1d>
table = $REPO/validation/self_gravity/inputs/tables/L3_n5_collapse.txt
geometry = spherical
nsub = 2

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = none
numlevel   = 1
multigrid  = true
nx1 = 128
x1min = -5.12
x1max = 5.12
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -5.12
x2max = 5.12
ix2_bc = outflow
ox2_bc = outflow
nx3 = 128
x3min = -5.12
x3max = 5.12
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 6.0
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.3
riemann        = hlld
reconstruction = plm
cons_diag      = true

<parthenon/output0>
file_type = hdf5
variables = prim, grav.phi
single_precision_output = true
dt = 0.1

<parthenon/output1>
file_type = hst
dt = 0.01

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
