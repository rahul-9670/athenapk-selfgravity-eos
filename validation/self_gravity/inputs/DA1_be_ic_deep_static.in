<comment>
problem = production collapse_be IC, single Poisson solve on 6 nested static levels (finest dx = 0.0039):
          phi and force error per level vs the exact potential.

<job>
problem_id = collapse_be

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
omegatff = 0.0
turb_mach = 0.0

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = static
numlevel   = 7
multigrid  = true
nx1 = 64
x1min = -8.0
x1max = 8.0
ix1_bc = diode
ox1_bc = diode
nx2 = 64
x2min = -8.0
x2max = 8.0
ix2_bc = diode
ox2_bc = diode
nx3 = 64
x3min = -8.0
x3max = 8.0
ix3_bc = diode
ox3_bc = diode

<parthenon/static_refinement1>
level = 1
x1min = -4.0
x1max = 4.0
x2min = -4.0
x2max = 4.0
x3min = -4.0
x3max = 4.0

<parthenon/static_refinement2>
level = 2
x1min = -2.0
x1max = 2.0
x2min = -2.0
x2max = 2.0
x3min = -2.0
x3max = 2.0

<parthenon/static_refinement3>
level = 3
x1min = -1.0
x1max = 1.0
x2min = -1.0
x2max = 1.0
x3min = -1.0
x3max = 1.0

<parthenon/static_refinement4>
level = 4
x1min = -0.5
x1max = 0.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<parthenon/static_refinement5>
level = 5
x1min = -0.25
x1max = 0.25
x2min = -0.25
x2max = 0.25
x3min = -0.25
x3max = 0.25

<parthenon/static_refinement6>
level = 6
x1min = -0.125
x1max = 0.125
x2min = -0.125
x2max = 0.125
x3min = -0.125
x3max = 0.125

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl = 1.0e-6
tlim = 1.0e30
nlim = 1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.4
riemann        = hlld
reconstruction = plm
cons_diag      = true
boundary_flux_clamp = true

<parthenon/output0>
file_type = hdf5
dt = 1.0e30
variables = prim, grav.phi

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
