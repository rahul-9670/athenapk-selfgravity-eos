<comment>
problem = Boss and Bodenheimer (1979) standard isothermal test: uniform sphere alpha = 0.26,
          beta = 0.16, m = 2 perturbation 10 %; rho0 = cs = 1, 4 pi G = 1; barotropic at 2.6e4; Jeans AMR njeans = 8.

<job>
problem_id = profile1d

<problem/profile1d>
table = $REPO/validation/self_gravity/inputs/tables/L9_boss_bodenheimer.txt
geometry = spherical
nsub = 2
omega = 0.4
m2_amp = 0.1
rho_out = 0.01
p_out = 0.01
barotropic = true
rho_crit = 2.6e4
zero_mom_radius = 5.3708615553

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = adaptive
numlevel   = 12
multigrid  = true
nx1 = 64
x1min = -12.0
x1max = 12.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -12.0
x2max = 12.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -12.0
x3max = 12.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16


<refinement>
type   = jeans
njeans = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 2.6
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.4
riemann        = hlld
reconstruction = plm
cons_diag      = true
boundary_flux_clamp = true
dfloor = 1.0e-6
pfloor = 1.0e-8

<parthenon/output0>
file_type = hdf5
variables = prim
single_precision_output = true
dt = 0.05

<parthenon/output1>
file_type = hst
dt = 0.005

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
