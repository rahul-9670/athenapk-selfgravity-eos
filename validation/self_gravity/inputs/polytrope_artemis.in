<comment>
problem = n = 1 polytrope (SG-D5 static, SG-D6 collision iprob=2); artemis inputs/self-gravity/poly.in.
          gamma = 2, P = rho^2 (K = 1), rho_c = 1, four_pi_G = 1 -> Lane-Emden xi = r/sqrt(2),
          truncated at xi = 0.75 pi (R = 3.332) in an ambient rho = 1e-3, sie = 100.
          Default = production-like box [-8,8]^3 with multipole BCs; the artemis-matched leg
          ([-32,32]^3, zero BC, 3-level AMR) is set on the CLI by scripts/sg_suite.py.

<job>
problem_id = polytrope

<problem/polytrope>
iprob   = 1
rho_amb = 1.0e-3
sie_amb = 1.0e2

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = static
numlevel   = 3
multigrid  = true
nx1    = 64
x1min  = -32.0
x1max  =  32.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = -32.0
x2max  =  32.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = -32.0
x3max  =  32.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 20.0
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 2.0
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm
cons_diag      = true

<parthenon/output0>
file_type = hdf5
dt        = 2.0
variables = prim, grav.phi
single_precision_output = true

<parthenon/output1>
file_type = hst
dt        = 0.05

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc = zero
ox1_bc = zero
ix2_bc = zero
ox2_bc = zero
ix3_bc = zero
ox3_bc = zero
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true

# artemis poly.in uses 3-level ADAPTIVE refinement on density; static nesting is used here so
# the mesh is identical at every output (dx = 0.25 on |x| < 6, the star radius is 3.33).
<parthenon/static_refinement1>
level = 1
x1min = -12.0
x1max =  12.0
x2min = -12.0
x2max =  12.0
x3min = -12.0
x3max =  12.0

<parthenon/static_refinement2>
level = 2
x1min = -6.0
x1max =  6.0
x2min = -6.0
x2max =  6.0
x3min = -6.0
x3max =  6.0
