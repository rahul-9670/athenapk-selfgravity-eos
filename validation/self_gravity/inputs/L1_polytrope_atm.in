<comment>
problem = n = 1 polytrope (gamma = 2) with a hydrostatic self-gravitating atmosphere (Mullen,
          Hanawa and Gammie 2021 Sec. 4.3); G = M = R = 1, Ma = 0.01, box 8R, multipole BC. tau = R/v_esc = 0.7071

<job>
problem_id = profile1d

<problem/profile1d>
table = $REPO/validation/self_gravity/inputs/tables/L1_polytrope_atm.txt
geometry = spherical
nsub = 2

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = none
numlevel   = 1
multigrid  = true
nx1 = 80
x1min = -4.0
x1max = 4.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 80
x2min = -4.0
x2max = 4.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 80
x3min = -4.0
x3max = 4.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 7.0710678
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 2.0
riemann        = hlld
reconstruction = plm
cons_diag      = true
pfloor = 1e-14
dfloor = 1e-12

<parthenon/output0>
file_type = hdf5
variables = prim, grav.phi
single_precision_output = true
dt = 0.70710678

<parthenon/output1>
file_type = hst
dt = 0.070710678

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 12.566370614359172
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
