<comment>
problem = exact isothermal Bonnor-Ebert sphere xi_max = 9.0, f = 1.0, confined by a LIGHT hot ambient
          (1/100 edge density at the edge pressure), gamma = 1.001 (near-isothermal), outflow BC, Jeans AMR;
          vs the 1D Lagrangian reference (constant external pressure). Replaces the collapse_be L6 (SG-F5).

<job>
problem_id = profile1d

<problem/profile1d>
table = $REPO/validation/self_gravity/inputs/tables/L6b_be_xi9_f1.txt
geometry = spherical
nsub = 2
rho_out = 0.0003106857240393324
p_out = 0.031068572403933237

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = adaptive
numlevel   = 6
multigrid  = true
nx1 = 64
x1min = -12.0
x1max = 12.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -12.0
x2max = 12.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -12.0
x3max = 12.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16


<refinement>
type   = jeans
njeans = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 30.0
nlim       = -1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.001
riemann        = hlld
reconstruction = plm
cons_diag      = true
dfloor = 1.0e-6
pfloor = 1.0e-8

<parthenon/output0>
file_type = hdf5
variables = prim
single_precision_output = true
dt = 1.0

<parthenon/output1>
file_type = hst
dt = 0.1

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
