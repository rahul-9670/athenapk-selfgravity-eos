<comment>
problem = Pressure-free uniform-sphere collapse (SG-D7), re-run of WP-15 with the PRODUCTION
          solver keys and a volume-averaged (sub-sampled) sphere surface instead of WP-15's
          stair-step. rho_c(t) vs the exact cycloid. Deck traps from WP-15 are kept: dt_ceil
          (not dt_max), modest output cadence, ambient rho 1e-2 (a hotter ambient goes supersonic).

<job>
problem_id = grav_analytic

<problem/grav_analytic>
profile  = spheres
m1       = 268.082573106329    # rho_in = 1, R = 4
r1       = 4.0
rho_out  = 1.0e-2
pressure = 1.0e-6
nsub     = 8

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = none
multigrid  = true
nx1    = 64
x1min  = -8.0
x1max  =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = -8.0
x2max  =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = -8.0
x3max  =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.2
tlim       = 1.85
nlim       = -1
dt_ceil    = 0.002
dt_init    = 1.0e-4

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.4
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-14
cons_diag      = true

<parthenon/output0>
file_type = hdf5
dt        = 0.05
variables = prim
single_precision_output = true

<parthenon/output1>
file_type = hst
dt        = 0.002

<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true
