<comment>
problem = Static density fields with exact potentials (SG-S tests). One cycle at tiny CFL;
          grav.phi of the final dump is compared to scripts/exact_potentials.py.
          Defaults = SG-S3 uniform sphere (WS-5a gate), production box [-8,8]^3.

<job>
problem_id = grav_analytic

<problem/grav_analytic>
profile  = spheres
m1       = 268.082573106329    # (4/3) pi 4^3 -> rho_in = 1
r1       = 4.0
rho_out  = 1.0e-10
pressure = 1.0
nsub     = 8

<parthenon/mesh>
task_collection_timeout_in_seconds = 7200   # production value
refinement = static
numlevel   = 3
multigrid  = true
nx1    = 64
x1min  = -8.0
x1max  =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = -8.0
x2max  =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = -8.0
x3max  =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 1.0e-6
tlim       = 1.0e30
nlim       = 1

<hydro>
fluid          = glmmhd
glmmhd_source  = dedner_extended
eos            = adiabatic
gamma          = 1.6666666666666667
riemann        = hlld   # production solver (artemis/Athena++ references use HLLC)
reconstruction = plm
dfloor         = 1.0e-30
pfloor         = 1.0e-30

<parthenon/output0>
file_type = hdf5
dt        = 1.0e30
variables = prim, grav.phi
<physics>
self_gravity = true

<self_gravity>
units_override     = true
four_pi_G          = 1.0
use_swindle        = false
packed_bc          = true
ix1_bc             = multipole
ox1_bc             = multipole
ix2_bc             = multipole
ox2_bc             = multipole
ix3_bc             = multipole
ox3_bc             = multipole
mp_deterministic   = true
solver_diag        = true
phi_operator_split = true
phi_prolongation   = linear

<self_gravity/solver_params>
solver             = BiCGSTAB
max_iterations     = 200
residual_tolerance = 1.0e-6
relative_residual  = true
do_FAS             = true
max_coarsenings    = 20
smoother           = SRJ2
presmoother        = SRJ2
postsmoother       = SRJ2
preconditioner     = Multigrid
seed_from_phi      = true

# SG-S3a: same sphere, two static levels; the level-1 boundary (|x|=5) is OUTSIDE the
# surface and the level-2 boundary (|x|=2) is INSIDE it, so the solve crosses C/F faces in
# both the mass-free and the massive region.
<parthenon/static_refinement1>
level = 1
x1min = -5.0
x1max =  5.0
x2min = -5.0
x2max =  5.0
x3min = -5.0
x3max =  5.0

<parthenon/static_refinement2>
level = 2
x1min = -2.0
x1max =  2.0
x2min = -2.0
x2max =  2.0
x3min = -2.0
x3max =  2.0
