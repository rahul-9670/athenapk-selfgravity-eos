<comment>
problem = ideal_mhd I7 BW ref t=0.3

<job>
problem_id = ideal_mhd

<problem/ideal_mhd>
mode = shocktube
x0 = 0.5
B0x = 0.75
rhoL = 1.0
rhoR = 0.125
vxL = 0.0
vxR = 0.0
vyL = 0.0
vyR = 0.0
vzL = 0.0
vzR = 0.0
PL = 1.0
PR = 0.1
ByL = 1.0
ByR = -1.0
BzL = 0.0
BzR = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 4608
x1min = -4
x1max = 5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 576
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.3
nlim = -1

<hydro>
fluid = glmmhd
riemann = hlld
reconstruction = plm
divergence_control = glm
glmmhd_source = dedner_extended
glmmhd_alpha = 0.1
first_order_flux_correct = false
vl2_predictor_recon = same
dfloor = 1.0e-6
pfloor = 1.0e-8
eos_floor_consistent = true
lean_registers = true
ghost_sync_rounds = 1
eos = adiabatic
gamma = 2.0
Tfloor = -1             # forced (S tier): ideal-gas Tfloor needs units + He fraction
double_flux = false     # forced (S tier): double_flux needs eos = hydrogen
eos_table_allow_no_radiation = true   # validation-only escape: dual energy without radiation (hydro.cpp:2195)
boundary_flux_clamp = false   # I7 ref
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_shared_select = true
dual_comp_ghost = true
dual_energy_heat_rkl2 = true
dual_energy_heat_exact = true
dual_energy_flux = density
boundary_clamp_dual = true

<physics>
self_gravity = false
radiation = false

<parthenon/output0>
file_type = hdf5
variables = prim, cons
dt = 0.075

<parthenon/output1>
file_type = hst
dn = 5
