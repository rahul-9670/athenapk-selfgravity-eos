<comment>
problem = ideal_mhd fix campaign: no-inflow wall test, gas leaving both walls at u0 = 0.1, By = 1.0

<job>
problem_id = ideal_mhd

<problem/ideal_mhd>
mode = shocktube
x0 = 0.5
B0x = 0.0
rhoL = 1.0
rhoR = 1.0
vxL = 0.1
vxR = -0.1
vyL = 0.0
vyR = 0.0
vzL = 0.0
vzR = 0.0
PL = 0.6
PR = 0.6
ByL = 1.0
ByR = 1.0
BzL = 0.0
BzR = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 256
x1min = 0
x1max = 1
ix1_bc = diode
ox1_bc = diode
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = diode
ox2_bc = diode
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = diode
ox3_bc = diode

<parthenon/meshblock>
nx1 = 256
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.3
nlim = -1

<hydro>
fluid = glmmhd
riemann = hlld
reconstruction = plm
divergence_control = glm
glmmhd_source = dedner_extended
glmmhd_alpha = 0.1
first_order_flux_correct = false
vl2_predictor_recon = same
dfloor = 1.0e-6
pfloor = 1.0e-8
eos_floor_consistent = true
lean_registers = true
ghost_sync_rounds = 1
eos = adiabatic
gamma = 1.6666666666666667
Tfloor = -1             # forced (S tier): ideal-gas Tfloor needs units + He fraction
double_flux = false     # forced (S tier): double_flux needs eos = hydrogen
eos_table_allow_no_radiation = true   # validation-only escape: dual energy without radiation (hydro.cpp:2195)
boundary_flux_clamp = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_shared_select = true
dual_comp_ghost = true
dual_energy_heat_rkl2 = true
dual_energy_heat_exact = true
dual_energy_flux = density
boundary_clamp_dual = true

<physics>
self_gravity = false
radiation = false

<parthenon/output0>
file_type = hdf5
variables = prim
dt = 0.1
