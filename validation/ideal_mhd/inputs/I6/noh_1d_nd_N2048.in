<comment>
problem = ideal_mhd I6 Noh 1D N=2048 dual=False pred=same

<job>
problem_id = ideal_mhd

<problem/ideal_mhd>
mode = noh
rho0 = 1.0
v0 = 1.0
P0 = 1.0e-6

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 2048
x1min = -1
x1max = 1
ix1_bc = diode
ox1_bc = diode
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = diode
ox2_bc = diode
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = diode
ox3_bc = diode

<parthenon/meshblock>
nx1 = 2048
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.6
nlim = -1

<hydro>
fluid = glmmhd
riemann = hlld
reconstruction = plm
divergence_control = glm
glmmhd_source = dedner_extended
glmmhd_alpha = 0.1
first_order_flux_correct = false
vl2_predictor_recon = same
dfloor = 1.0e-6
pfloor = 1.0e-8
eos_floor_consistent = true
lean_registers = true
ghost_sync_rounds = 1
eos = adiabatic
gamma = 1.6666666666666667
Tfloor = -1             # forced (S tier): ideal-gas Tfloor needs units + He fraction
double_flux = false     # forced (S tier): double_flux needs eos = hydrogen
eos_table_allow_no_radiation = true   # validation-only escape: dual energy without radiation (hydro.cpp:2195)
boundary_flux_clamp = true
dual_energy = false

<physics>
self_gravity = false
radiation = false

<parthenon/output0>
file_type = hdf5
variables = prim
dt = 0.2

<parthenon/output1>
file_type = hst
dn = 10
