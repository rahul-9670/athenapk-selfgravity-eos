<comment>
problem = ideal_mhd I1c tabulated-EOS wave N=32 B0y=12.113223537335648 cs=1.279488034151194 cf=9.047346653953541 dual=False

<job>
problem_id = eos_test

<problem/eos_test>
mode = wave
rho0 = 1.8291567587342235
T0 = 10.0
amp = 1.0e-6
B0y = 12.113223537335648
wave_fast = true

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.11052964346878612
nlim = -1

<hydro>
fluid = glmmhd
riemann = hlld
reconstruction = plm
divergence_control = glm
glmmhd_source = dedner_extended
glmmhd_alpha = 0.1
first_order_flux_correct = false
vl2_predictor_recon = same
dfloor = 1.0e-6
pfloor = 1.0e-8
eos_floor_consistent = true
lean_registers = true
ghost_sync_rounds = 1
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold_rho26.bin
gamma = 1.4             # production deck value; unused by the table
eos_interp = p
Tfloor = 0.2726
double_flux = true
eos_table_allow_no_radiation = true   # validation-only escape (no radiation in these tests)
boundary_flux_clamp = false   # periodic box: DE-F2 (clamp ignores the BC type)
dual_energy = false

<physics>
self_gravity = false
radiation = false

<parthenon/output0>
file_type = hdf5
variables = prim
dt = 0.11052964346878612
