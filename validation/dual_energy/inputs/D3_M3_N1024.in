<comment>
problem = D3 planar Noh, u = +-3 cs0, T0 10 K, N 1024; exact rho2 3.42866 P2 21.7828 T2 64.67 K

<job>
problem_id = eos_test

<problem/eos_test>
mode = riemann
x0 = 0.5
rhoL = 1.0
espL_code = 1.4714108718138108
uL = 3.8384641024535817
rhoR = 1.0
espR_code = 1.4714108718138108
uR = -3.8384641024535817

<parthenon/mesh>
refinement = none
nx1 = 1024
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 1024
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.1898151038931026
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold_rho26.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_plain   # 1D: dedner_extended segfaults (E-F3); B.grad(psi) needs >= 2D
dfloor = 1.0e-6
pfloor = 1.0e-8
Tfloor = 0.2726   # code T units (10.0 K) -> 2.73 K, production 2026-10-06
boundary_flux_clamp = false   # production = true, but it zeroes inflow on EVERY mesh-edge face without checking the BC type: a periodic box loses its through-flow (DE-F2)
cons_diag = true
eos_floor_consistent = true
eos_interp = p
vl2_predictor_recon = dc
double_flux = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_comp_ghost = true
boundary_clamp_dual = true
ghost_sync_rounds = 1


<physics>
self_gravity = false

<parthenon/output0>
file_type = hdf5
variables = prim, cons, dual_switched
dt = 0.04745377597327565

<parthenon/output1>
file_type = hst
dt = 0.000949075519465513
