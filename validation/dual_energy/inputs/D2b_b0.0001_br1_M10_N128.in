<comment>
problem = D2b div B blob, beta 0.0001, bamp/B0z 1, |v| = 10 cs0, N 128^2

<job>
problem_id = eos_test

<problem/eos_test>
mode = divb
rho0 = 1.0
T0 = 10.0
u0 = 9.04734665395354
v0y = 9.04734665395354
B0z = 140.1706851073678
bamp = 140.1706851073678
rb = 0.125

<parthenon/mesh>
refinement = none
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 128
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.11052964346878615
nlim = -1

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = $REPO/src/eos/eos_table_hires_v5_cold_rho26.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended   # production
dfloor = 1.0e-6
pfloor = 1.0e-8
Tfloor = 0.2726   # code T units (10.0 K) -> 2.73 K, production 2026-10-06
boundary_flux_clamp = false   # production = true, but it zeroes inflow on EVERY mesh-edge face without checking the BC type: a periodic box loses its through-flow (DE-F2)
cons_diag = true
eos_floor_consistent = true
eos_interp = p
vl2_predictor_recon = dc
double_flux = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_comp_ghost = true
boundary_clamp_dual = true
ghost_sync_rounds = 1


<physics>
self_gravity = false

<parthenon/output0>
file_type = hdf5
variables = prim, cons, dual_switched
dt = 0.027632410867196536

<parthenon/output1>
file_type = hst
dt = 0.0005526482173439307
