<comment>
problem = A3_oblique_rkl2_N128 (nonideal_mhd A1/A3, production keys)
# AD) gate. By = amp*sin(k x) on a uniform guide field Bx=B0 decays as a damped Alfven mode;
# the measured amplitude is checked against the analytic 2-mode envelope. 2D box (nx2=8) so
# the matched CT run has a real transverse dimension. Differs from diffusion_ad_ct.in ONLY
# in divergence_control.

<job>
problem_id = diffusion

<problem/diffusion>
Bguide_y = 1.0
iprob = 50
Bx    = 1.0
By    = 0.0
amp   = 1.0e-6
nwave = 1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.03125
x2max = 0.03125
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 64
nx2 = 8
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.3
nlim = 10000000
ncycle_out = 500

<hydro>
fluid = glmmhd
riemann = hlld
eos = adiabatic
reconstruction = plm
gamma = 2.0
divergence_control = glm
eos_table_allow_no_radiation = true
dual_energy = true
dual_energy_eta1 = 5e-2
dual_energy_sync_step_end = true
dual_energy_unsigned_prim = true
dual_energy_exact_resync = true
dual_energy_eta2 = 0.1
dual_energy_kappa = 3.0
dual_energy_shock_comp = 0.02
dual_energy_shared_select = true
dual_comp_ghost = true
dual_energy_heat_rkl2 = true
dual_energy_heat_exact = true
boundary_clamp_dual = true
boundary_flux_clamp = false


<diffusion>
integrator = rkl2
rkl2_max_dt_ratio = 1000
rkl2_freeze_eta = true
eta_cache = true
cfl = 0.3
ambipolar = ambipolar
ambipolar_coeff = fixed
ambipolar_coeff_code = 0.5

<parthenon/output0>
file_type = hdf5
dt = 0.3
variables = prim
id = prim

<parthenon/output1>
file_type = hst
dt = 0.01
